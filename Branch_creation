# 1. Clone the repo (once, on day one)
git clone https://github.com/vherreravi/Project_Computer_Science.git
cd Project_Computer_Science

# 2. Create Your own branch using your name
git checkout -b student/firstname-lastname

# 3. After writing your functions check what has changed
git status

# 4. Stage their changes (This is where commit happens)
git add .

# 5. Commit with a message
git commit -m "Completed add and subtract functions"

# 6. Push your branch to GitHub (The changes only happen in your branch no changes to the main branch. )
git push -u origin student/firstname-lastname